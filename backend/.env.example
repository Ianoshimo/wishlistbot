DATABASE_URL="postgresql://user:password@localhost:5432/wishlistbot"
BOT_TOKEN="123456:paste-real-token-from-BotFather"
MINI_APP_URL="https://your-frontend-domain.example"
PORT=3000

# ЮKassa - подключить, когда закрыт открытый вопрос про юрлицо/чек 54-ФЗ
# (см. Продукт/спека-итерация-1.md, раздел "Открытые вопросы")
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# Платный фоллбэк для wildberries.ru, когда свой og-парсинг заблокирован
# антиботом (см. Продукт/беклог-баги-итерация-1.md - "найти бесплатное
# решение"). Токен - на console.apify.com/settings/integrations. Без него
# фоллбэк просто не срабатывает.
APIFY_TOKEN=""

# Разрешает вне настоящего Telegram (обычный браузер, локальная разработка)
# доверять telegramId из тела запроса вместо проверенной подписи initData -
# см. auth/telegramAuth.ts. НЕ ВКЛЮЧАТЬ В ПРОДЕ - иначе аутентификация не
# защищает вообще ничего.
ALLOW_DEV_TELEGRAM_ID=true
