// Модель данных под спеку итерации 1 (см. Продукт/спека-итерация-1.md).
// Осознанно не включено: партнёрки и парсинг ссылок (итерация 2),
// реферальная механика (итерация 3), поля под конкретный банк (итерация 4).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id @default(cuid())
  telegramId BigInt   @unique
  firstName  String
  username   String?
  createdAt  DateTime @default(now())

  // Телефон для перевода по СБП, когда получатель отмечает позицию как
  // "уже купил(а) сам(а)" - см. Item.selfPurchased. Хранится на User, а не
  // на Item, потому что это реквизит человека, не конкретного подарка:
  // один и тот же номер подставляется для всех его самостоятельных покупок.
  sbpPhone String?

  // Аудит 2026-10-08, А-5 (решение владельца): реквизиты по умолчанию для
  // денежных подарков - форма добавления подставляет их, на подарке их
  // можно изменить (у Item свои копии), последние введённые запоминаются
  // здесь. sbpPhone выше - тот же смысл (номер по умолчанию).
  sbpBank       String?
  fundraiserUrl String?

  // Беклог Б-15: ICS-фид раньше искал пользователя прямо по telegramId -
  // он не секрет (виден в Telegram-группах/URL профиля), значит чужой
  // календарь можно было скачать, просто подставив чужой id. Фид - обычный
  // URL, который периодически дёргает внешнее приложение календаря, поэтому
  // initData-авторизация (как у остальных роутов) здесь не подходит - нужен
  // долгоживущий секрет в самом URL.
  calendarToken String @unique @default(cuid())

  wishlists     Wishlist[]
  reservations  Item[]         @relation("ReservedBy")
  pools         Pool[]         @relation("OrganizedBy")
  contributions Contribution[]
  giftShares    GiftShare[]
}

model Wishlist {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  slug      String   @unique @default(cuid())
  createdAt DateTime @default(now())

  // "До 3 вишлистов на человека, с названиями" (CLAUDE.md, 2026-10-02) -
  // продуктовый лимит на количество (WISHLIST_LIMIT в routes/wishlists.ts),
  // не ограничение на уровне БД.
  title String @default("Мой вишлист")

  // Повод (например день рождения) живёт на вишлисте, а не на Pool
  // (групповой сбор денег, итерация 2) - не требует денег/сбора, работает
  // уже в итерации 1. Оба поля заполняются только вместе - см. валидацию
  // в routes/wishlists.ts. Источник для разового .ics и для личной
  // webcal-подписки (services/ics.ts).
  occasionTitle String?
  occasionDate  DateTime?

  items Item[]
}

// Аудит 2026-10-08, А-5: способ получить деньги выбирается на каждый
// подарок отдельно и не зависит от "уже купил сам". null - денег нет,
// даритель покупает в магазине.
enum PayoutMethod {
  sbp
  fundraiser
}

enum ItemStatus {
  available
  reserved
  bought
}

model Item {
  id         String     @id @default(cuid())
  wishlistId String
  wishlist   Wishlist   @relation(fields: [wishlistId], references: [id])
  url        String
  title      String?
  price      Int? // в копейках
  imageUrl   String? // og:image со страницы товара или прямая ссылка на картинку - см. services/linkPreview.ts
  status     ItemStatus @default(available)

  // Получатель уже купил подарок сам - с аудита 2026-10-08 (А-5) это
  // только информация "идти в магазин не нужно". Куда переводить деньги -
  // payoutMethod ниже (у "уже купил сам" он обязателен).
  selfPurchased Boolean @default(false)

  // Аудит 2026-10-08, А-5: способ получить деньги и реквизиты этого
  // подарка (по умолчанию - из профиля владельца, см. User). Номер и банк
  // видит только держатель брони/доли и владелец (hotfix Н-1), ссылку на
  // сбор - только участники и владелец (services/itemView.ts).
  payoutMethod PayoutMethod?
  sbpPhone     String?
  sbpBank      String?

  // "Хочу больше всего" - тоггл получателя, когда позиций много и
  // дарителю неочевидно, с чего начать. Стандартный паттерн вишлистов
  // (как у Amazon) - см. CLAUDE.md, 2026-10-01.
  priority Boolean @default(false)

  reservedByUserId String?
  reservedBy       User?     @relation("ReservedBy", fields: [reservedByUserId], references: [id])
  reservedAt       DateTime?
  reservationTtl   DateTime? // ресёрч спеки: 5 дней от reservedAt

  // "Дарить неанонимно" (CLAUDE.md, 2026-10-02) - даритель один раз, в
  // момент брони, решает раскрыть ли владельцу вишлиста, что дарит
  // именно он. По умолчанию анонимность не меняется (п.2 спеки) - имя
  // отдаётся наружу только isOwnerViewer и только когда true, см.
  // services/itemView.ts.
  reservedByVisible Boolean @default(false)

  // "Скинуться на подарок" (CLAUDE.md, 2026-10-02) - несколько дарителей
  // делят одну позицию, каждый бронирует свою долю через GiftShare.
  // maxContributors = 1 (по умолчанию) - обычный classic-путь на
  // reservedByUserId/TTL выше, без изменений. maxContributors > 1 -
  // режим "скинуться", у неоплаченной доли тот же TTL, что у брони
  // (см. GiftShare). Меняется при редактировании, пока позиция не
  // куплена и мест не меньше присоединившихся (services/itemEdit.ts).
  maxContributors Int         @default(1)
  giftShares      GiftShare[]

  // Сбор по ссылке банка (ТЗ блок 4, 2026-10-07): получатель создаёт сбор
  // в приложении банка, друзья скидываются через банк, деньги мимо
  // платформы. С А-5 - реквизит способа payoutMethod = fundraiser (и для
  // складчины, и для одного дарителя). Складчина требует payoutMethod.
  fundraiserUrl String?

  // Аудит 2026-10-08, А-14: когда держателю classic-брони последний раз
  // ушло напоминание (services/reminders.ts) - не чаще раза в сутки,
  // переживает рестарт процесса. Сбрасывается при новой брони.
  lastReminderAt DateTime?

  createdAt DateTime @default(now())
}

model GiftShare {
  id     String @id @default(cuid())
  itemId String
  // onDelete: Cascade - до этой миграции DELETE /api/items/:itemId падал
  // 500 (нарушение внешнего ключа), как только у позиции появлялась хотя
  // бы одна доля (см. CLAUDE.md, 2026-10-02).
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Доверительная самоотметка - каждый дольщик отмечает свою часть
  // независимо, не дожидаясь остальных; реальной обработки платежа нет,
  // СБП и так идёт вне платформы, как и весь selfPurchased-флоу.
  paid Boolean @default(false)

  // "Дарить неанонимно" для конкретной доли - своя копия чекбокса на
  // каждого дольщика, раз у каждого выбор свой (в отличие от classic-
  // брони, где это поле одно на Item.reservedByVisible).
  visible Boolean @default(false)

  // TTL доли (2026-10-07) считается от createdAt - отдельного поля нет:
  // неоплаченная доля старше RESERVATION_TTL_DAYS (5 дней, как у брони)
  // снимается лениво при чтении, оплаченная - никогда. См.
  // services/reservation.ts, resolveExpiredGiftShares.
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  // Аудит 2026-10-08, А-14: последнее напоминание дольщику (см.
  // Item.lastReminderAt).
  lastReminderAt DateTime?

  @@unique([itemId, userId])
}

enum PoolStatus {
  open
  collected
  expired
}

model Pool {
  id           String     @id @default(cuid())
  organizerId  String
  organizer    User       @relation("OrganizedBy", fields: [organizerId], references: [id])
  title        String // повод, например "День рождения Кати"
  occasionDate DateTime? // дата повода - для календаря, не срок сбора
  targetAmount Int? // в копейках, null = без цели
  deadline     DateTime
  status       PoolStatus @default(open)
  createdAt    DateTime   @default(now())

  contributions Contribution[]
}

enum ContributionStatus {
  pending
  success
  failed
  refunded
}

model Contribution {
  id            String             @id @default(cuid())
  poolId        String
  pool          Pool               @relation(fields: [poolId], references: [id])
  contributorId String
  contributor   User               @relation(fields: [contributorId], references: [id])
  amount        Int // в копейках
  status        ContributionStatus @default(pending)

  // Заполняется при подключении ЮKassa - см. Открытые вопросы в спеке
  // (тип чека "добровольный взнос" под 54-ФЗ ещё не подтверждён).
  yookassaPaymentId String?

  createdAt DateTime @default(now())
}

// Продуктовая аналитика (2026-10-07) - собственная таблица событий в той
// же Postgres, не сторонний сервис: событийные данные о желаниях/покупках,
// привязанные к поводу, и есть актив проекта (см. CLAUDE.md, "Суть"), и
// отдавать их (вместе с персональными данными) третьим лицам не хотим.
// Пишется только через services/analytics.ts track() - fire-and-forget.
//
// Связи с User/Wishlist/Item нарочно НЕ внешние ключи: событие - запись
// истории, она должна переживать удаление позиции (DELETE /api/items) и
// не должна мешать ему.
//
// Приватность: в props никогда не пишутся телефоны, telegramId, имена,
// initData, тексты сообщений, file_id медиа - только внутренний User.id.
model Event {
  id         String   @id @default(cuid())
  type       String
  userId     String?
  wishlistId String?
  itemId     String?
  props      Json     @default("{}")
  // Ключ дедупликации для частых событий (просмотр чужого вишлиста,
  // опрос календарной подписки) - "одно событие на пользователя+объект
  // в сутки"; повтор упирается в unique и молча отбрасывается.
  dedupeKey  String?  @unique
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([wishlistId])
}
